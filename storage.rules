rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Profile photos & avatar uploads
    match /profile_photos/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /profile_images/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Portfolio media uploads (images, videos, audioTracks)
    match /portfolios/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Chat attachments & media
    match /chat_attachments/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Gig images & documents
    match /gigs/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Default fallback rule for storage assets
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
