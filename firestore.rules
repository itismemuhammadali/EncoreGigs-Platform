rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Organizers ---
    match /organizers/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isSignedIn();
      allow delete: if false;
    }

    // --- Musicians ---
    // Task 5-9: Primary/Secondary City, Subgenres, Hourly Rate, Instruments, Profiles
    match /musicians/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isSignedIn();
      allow delete: if false;
    }

    // --- Gigs ---
    // Task 3: Feed Filtering & Gig Leads
    match /gigs/{gigId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.organizerId == request.auth.uid || request.auth.token.admin == true);
    }

    // --- Notifications ---
    // Task 2: Clickable Notifications & Read Status Synchronization
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // --- Applications ---
    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Bookings ---
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- Chats ---
    // Task 4: Chat Bubbles & Messaging
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, create, update: if isSignedIn();
      }
    }

    // --- Support Chats ---
    match /support_chats/{userId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
    
    // --- Policies & Terms ---
    match /policies/{policyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Deleted Users Archive (Audit Trail) ---
    match /deleted_users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Fallback for administrative & auxiliary documents
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
